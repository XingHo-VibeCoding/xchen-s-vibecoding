{
  "envId": "cxj1528-d4g55ng0o54cbe296",
  "version": "2.1",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "health",
      "type": "HTTP",
      "dir": "./cloudfunctions/health",
      "runtime": "Nodejs20.19",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "read",
      "type": "HTTP",
      "dir": "./cloudfunctions/read",
      "runtime": "Nodejs20.19",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "chat",
      "type": "HTTP",
      "dir": "./cloudfunctions/chat",
      "runtime": "Nodejs20.19",
      "description": "Day 17 建的骨架，Day 18 起填 AI 实现。超时给到 60 秒（AI 要等模型回话，与 read 的 20 秒是两回事）",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "write",
      "type": "HTTP",
      "dir": "./cloudfunctions/write",
      "runtime": "Nodejs20.19",
      "description": "写与改删: POST /api/sessions/write 写入一场练习; PATCH /api/sessions/write 改条目备注与收藏; DELETE /api/sessions/write 删单条条目。Day 18/22。三个方法共用一条路径(网关不能按方法分流且控制台建不了 WEB_SCF 路由),该路径要排在 GET 的前面",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "analyze",
      "type": "HTTP",
      "dir": "./cloudfunctions/analyze",
      "runtime": "Nodejs20.19",
      "description": "整场结束后的偏题与逻辑判断接口,契约第四章。与 chat 分开:chat 每轮调等一句话,analyze 整场调一次吃整份 transcript",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true
    }
  ],
  "hosting": [
    {
      "name": "web",
      "root": "./.deploy/hosting",
      "framework": "static",
      "deployPath": "/"
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/api/sessions/write",
        "target": "function:write",
        "enablePathTransmission": true
      },
      {
        "path": "/api/sessions",
        "target": "function:read",
        "enablePathTransmission": true
      },
      {
        "path": "/api/favorites",
        "target": "function:read",
        "enablePathTransmission": true
      },
      {
        "path": "/api/items/favorites",
        "target": "function:read",
        "enablePathTransmission": true
      },
      {
        "path": "/api/chat",
        "target": "function:chat",
        "enablePathTransmission": true
      },
      {
        "path": "/api/analyze",
        "target": "function:analyze",
        "enablePathTransmission": true
      },
      {
        "path": "/api",
        "target": "function:health"
      },
      {
        "path": "/",
        "target": "hosting:web"
      }
    ]
  }
}
