{
  "envId": "cxj1528-d4g55ng0o54cbe296",
  "version": "2.1",
  "functionRoot": "./cloudfunctions",
  "functions": [
    {
      "name": "health",
      "type": "HTTP",
      "dir": "./cloudfunctions/health",
      "runtime": "Nodejs20.19",
      "timeout": 10,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "read",
      "type": "HTTP",
      "dir": "./cloudfunctions/read",
      "runtime": "Nodejs20.19",
      "timeout": 20,
      "memorySize": 256,
      "installDependency": true
    },
    {
      "name": "chat",
      "type": "HTTP",
      "dir": "./cloudfunctions/chat",
      "runtime": "Nodejs20.19",
      "description": "Day 17 建的骨架，Day 18 起填 AI 实现。超时给到 60 秒（AI 要等模型回话，与 read 的 20 秒是两回事）",
      "timeout": 60,
      "memorySize": 256,
      "installDependency": true
    }
  ],
  "hosting": [
    {
      "name": "web",
      "root": "./.deploy/hosting",
      "framework": "static",
      "deployPath": "/"
    }
  ],
  "gateway": {
    "routes": [
      {
        "path": "/api/sessions",
        "target": "function:read",
        "enablePathTransmission": true
      },
      {
        "path": "/api/favorites",
        "target": "function:read",
        "enablePathTransmission": true
      },
      {
        "path": "/api/items/favorites",
        "target": "function:read",
        "enablePathTransmission": true
      },
      {
        "path": "/api/chat",
        "target": "function:chat",
        "enablePathTransmission": true
      },
      {
        "path": "/api",
        "target": "function:health"
      },
      {
        "path": "/",
        "target": "hosting:web"
      }
    ]
  }
}
