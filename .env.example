# =============================================================
#  .env.example —— 环境变量清单（Day 23 · 安全自查）
# =============================================================
#  ★ 这个文件里**只有键名，没有值**。它是给人看的模板，不是配置文件。
#    真实的值有三个地方，都不进仓库：
#      ① 云函数的控制台环境变量（部署时配，代码里读 process.env.X）
#      ② 本地开发时自建一份 .env（已被 .gitignore 忽略，不会被提交）
#      ③ 本地探针脚本读 .cloudbase-api-key.local.json（同样被忽略）
#
#  怎么用：
#    照着下面 10 个键名，在控制台给对应的云函数配好值。
#    本地要跑探针的话，复制一份成.env 再填值 —— 但 **.env 不要提交**。
#
#  ★ 本项目当前没有 .env 加载器（没有 dotenv 依赖）：
#    云函数侧的值一律在控制台配，代码用 process.env.XXX 读；
#    本地侧不读 .env，需要值的脚本自己 require 一个本地文件。
#    所以「建 .env.example」的作用是**把键名清单固定下来**，
#    让人换机器 / 换人接手时知道该配哪 10 个键，而不是让人以为「复制这个文件就能跑」。
#
#  ★ 值一律留空 = 不要在这里填任何真实密钥。
#    这个文件是要进仓库的，填了值等于把密钥公开出去。
# =============================================================


# -------------------------------------------------------------
#  1) 大模型（chat + analyze 两个函数共用）
# -------------------------------------------------------------
# 用在 cloudfunctions/chat/index.js 与 cloudfunctions/analyze/index.js。
# 缺 LLM_API_KEY 时函数启动自检会报 LLM_NOT_CONFIGURED，
# 接口返回 200 + ok:false，页面提示「AI 还没配好」。

# 【必填】大模型的 API Key。留空 = 没配。
#   从模型服务商控制台拿，只在控制台填，不要发到任何对话窗口。
LLM_API_KEY=

# 【选填】接口地址。不填则用代码里的默认值 https://api.deepseek.com
LLM_BASE_URL=https://api.deepseek.com

# 【选填】模型名。不填则用默认值 deepseek-chat
LLM_MODEL=deepseek-chat

# 【选填】调试开关。填1 会让 analyze 打印模型原始返回（排查用）。
#   ⚠️ 不要在生产环境长期开着 —— 它会把模型输出打到云函数日志里。
ANALYZE_DEBUG=


# -------------------------------------------------------------
#  2) CloudBase HTTP API（read + write 两个函数共用）
# -------------------------------------------------------------
# 用在 cloudfunctions/read/httpdb.js 与 cloudfunctions/write/httpdb.js。
# ★ 这两个文件是**各自一份副本**（无共享模块机制），改一份必须同步另一份。

# 【必填】CloudBase 的 API Key，等价于本环境管理员权限。
#   泄露它等于把整个环境的数据库敞开，所以它绝不能出现在代码或仓库里。
CLOUDBASE_API_KEY=

# 【选填】环境 ID。不填则用代码里的默认值 cxj1528-d4g55ng0o54cbe296
CLOUDBASE_ENV_ID=cxj1528-d4g55ng0o54cbe296


# -------------------------------------------------------------
#  3) 语音识别（speech 函数，Day 23 新增）
# -------------------------------------------------------------
# 用在 cloudfunctions/speech/index.js。
# ⚠️ 这三个是腾讯云账号级的密钥，权限比 CloudBase API Key 更高。
#   **泄露了必须立刻在控制台禁用并重新生成**，光删代码不作数。

# 【必填】腾讯云 SecretId
ASR_SECRET_ID=

# 【必填】腾讯云 SecretKey。控制台只显示一次，当场复制。
ASR_SECRET_KEY=

# 【必填】腾讯云 AppId（账号信息页）
ASR_APPID=

# 【选填】地域。不填则用默认值 ap-shanghai
ASR_REGION=ap-shanghai


# -------------------------------------------------------------
#  4) 数据库（当前版本未使用，保留占位）
# -------------------------------------------------------------
# PGHOST 在 read/index.js:290 只被用来打印一行「env 配没配」的启动日志。
# Day 18 起read/write 已改走 CloudBase HTTP API，不再直连 PG。
# 留着这个键是为了那行日志还能工作（它读 process.env.PGHOST）。

# 【选填】PG 主机地址，留空= 日志会打「env 未配置（会连不上）」
PGHOST=


# =============================================================
#  核对口径（改完配置后自查用，命令可直接复制）
# =============================================================
# ① 仓库里搜不到真实密钥（应为 0 条）：
#    git grep -nIE "AKID[A-Za-z0-9]{10,}" -- .
#    预期只会命中 .test-asr-sign.js 里的官方公开示例值（尾部带 *******）
#
# ② .env 确实被忽略：
#    git check-ignore -v .env
#    应输出 .gitignore:某行:.env
#
# ③ .env.example 没被忽略（否则说明文件进不了仓库）：
#    git check-ignore -v .env.example
#    应输出「无匹配」/ 退出码 1
# =============================================================